# Copy to .env (development) and .env.test (tests). Never commit real values.
# Each environment (development, test, staging, production) needs its own database, credentials and secrets.
# In staging/production, inject these from the secret manager instead of a file.
NODE_ENV=development
PORT=5001

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_DATABASE=admin_panel_db
DB_SSL=false
DB_POOL_MAX=10
DB_LOGGING=false
# Optional read replica (docs/database/read-replica.md): reads go there, writes to DB_HOST
DB_READ_HOST=
DB_READ_PORT=

# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=REPLACE_WITH_A_SECURE_SECRET_OF_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=15m
JWT_ISSUER=amrut-admin-backend
JWT_AUDIENCE=amrut-admin-panel

# Comma-separated allowed browser origins (the React admin panel dev server runs on 5174).
FRONTEND_URL=http://localhost:5174,http://localhost:5173
LOG_LEVEL=info

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
PERMISSION_CACHE_TTL_MS=60000

# Student data protection: two different 32-byte keys, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
STUDENT_DATA_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
STUDENT_INDEX_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
IMPORT_MAX_FILE_MB=20
IMPORT_MAX_ROWS=50000

# Document Master uploads: private storage directory (relative to the working directory) and size cap in MB.
DOCUMENT_STORAGE_DIR=storage/documents
DOCUMENT_MAX_FILE_MB=5

# LMS branding logo (F-LMS-04-02): maximum width / height in pixels, positive integers. Unset = no limit.
# The spec gives no values; the ones below are examples only. The logo's file size limit is DOCUMENT_MAX_FILE_MB.
# LMS_LOGO_MAX_WIDTH_PX=1024
# LMS_LOGO_MAX_HEIGHT_PX=512

# Browser sessions (ADR-0003): HttpOnly cookie. COOKIE_SECURE defaults to true outside development/test.
SESSION_COOKIE_NAME=amrut_session
COOKIE_SAMESITE=strict
# COOKIE_SECURE=true
# Set when the admin panel and the API are on different subdomains of one site, e.g. .example.gov.in
# COOKIE_DOMAIN=
SESSION_MAX_HOURS=12

# OpenAPI JSON + Swagger UI at /api/docs (default: on, except NODE_ENV=production)
# API_DOCS_ENABLED=true

# Student document storage (private; one folder per student). Relative paths resolve from the backend folder.
STORAGE_DIR=storage
# local (STORAGE_DIR) or s3. For s3 set region and bucket; keys are optional (instance role / AWS profile otherwise).
STORAGE_DRIVER=local
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Folder inside the bucket, e.g. dev or prod
AWS_KEY_PREFIX=
DOCUMENT_MAX_FILE_MB=5
DOCUMENTS_ZIP_MAX_MB=500
DOCUMENTS_ZIP_MAX_FILES=20000

# LMS sign-in with Admin Panel accounts: the LMS signs its /integration/v1/lms calls with this shared secret
# (HMAC-SHA256, at least 32 characters; the LMS holds the same value). Unset = Admin Panel users cannot sign in to the LMS.
LMS_INTEGRATION_SECRET=

# Amrut -> LMS student sync (M1, docs/lms-sync/README.md). Off by default: no call to the LMS until enabled.
# LMS_EXTERNAL_BASE_URL is the LMS API host (the client adds /tenant/v1). LMS_TENANT_API_KEY is the tenant key the
# LMS Super Admin issued for the Amrut tenant (scopes students.write + students.read): server-side only, never logged,
# never in a browser; inject it from the secret manager outside development.
LMS_SYNC_ENABLED=false
LMS_EXTERNAL_BASE_URL=
LMS_TENANT_API_KEY=
LMS_TENANT_CODE=AMRUT
LMS_SYNC_INTERVAL_SECONDS=60
LMS_SYNC_BATCH_SIZE=100
LMS_HTTP_TIMEOUT_MS=15000

# ENTREPRENEURSHIP DEVELOPMENT PROGRAM portal (edp.sumago.ai). Add the portal's origin to FRONTEND_URL in production,
# e.g. FRONTEND_URL=https://admin.example.com,https://edp.sumago.ai
# Token key of the portal and its tracking panel (at least 32 characters). Unset = derived from JWT_SECRET.
# EDP_JWT_SECRET=
# EDP_SESSION_HOURS=12
# One-time code lifetime in seconds (default 300 = 5 minutes)
EDP_OTP_TTL_SECONDS=300
# Seconds before a new code can be requested (it replaces the previous one). Empty = the lifetime above, so "Resend OTP"
# is offered only once the current code has expired.
EDP_OTP_RESEND_SECONDS=
# Sign-up / OTP / sign-in requests per IP per RATE_LIMIT_WINDOW_MS
EDP_RATE_LIMIT_MAX=30
# SMS gateway for the sign-up OTP (sent to the student's mobile number). SMS_DLT_TEMPLATE_ID is the DLT-registered template;
# SMS_OTP_MESSAGE must be that template's text with {otp} and {minutes} in place of its variables (the default below is a
# placeholder), otherwise the operator silently drops the SMS. Empty SMS_AUTH_KEY = no SMS (development logs the code).
SMS_API_URL=http://sms.happysms.in/api/sendhttp.php
SMS_AUTH_KEY=
SMS_SENDER=
SMS_DLT_TEMPLATE_ID=
SMS_ROUTE=4
SMS_COUNTRY=91
# SMS_OTP_MESSAGE=Your OTP for Entrepreneurship Development Program registration is {otp}. Valid for {minutes} minutes. - Sumago Infotech
# SMTP (other portal emails, e.g. the password reset link). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=<address>,
# SMTP_PASS=<16-character app password>. Unset host = no email (development logs the code instead; production refuses).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# e.g. "EDP – Sumago Infotech <no-reply@sumago.ai>"; defaults to SMTP_USER
SMTP_FROM=
# Tracking panel sign-in (edp.sumago.ai/manage), created by `npm run seed` when both are set; never overwritten.
EDP_ADMIN_EMAIL=
EDP_ADMIN_PASSWORD=
# The portal's address, used in the password reset email's link. Empty = https://edp.sumago.ai in production,
# http://localhost:5175 otherwise.
EDP_PORTAL_URL=
# Contact shown to students after they submit ("for any query, contact …"). Change and restart the API to update the
# portal. Empty = "contact the programme office" without details.
EDP_SUPPORT_EMAIL=
EDP_SUPPORT_MOBILE=
