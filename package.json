{
  "name": "amrut-admin-backend",
  "version": "1.0.0",
  "description": "Admin panel backend: Express + TypeScript + PostgreSQL + TypeORM with database-driven RBAC",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:create": "ts-node scripts/create-databases.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/database.config.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/database.config.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/database.config.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/config/database.config.ts",
    "migration:run:prod": "typeorm migration:run -d dist/src/config/database.config.js",
    "seed": "ts-node src/database/seeds/run-seeds.ts",
    "seed:prod": "node dist/src/database/seeds/run-seeds.js",
    "admin:create": "ts-node scripts/create-admin.ts",
    "admin:create:prod": "node dist/scripts/create-admin.js",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:db": "jest --runInBand --selectProjects db",
    "test:contract": "jest --runInBand --selectProjects db tests/contract",
    "test:e2e": "jest --runInBand --selectProjects db tests/e2e",
    "test:coverage": "jest --runInBand --coverage",
    "set-db-password": "ts-node scripts/set-db-password.ts",
    "demo:users": "ts-node scripts/create-demo-users.ts",
    "edp:admin": "ts-node scripts/create-edp-admin.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "yauzl": "^3.1.3",
    "yazl": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
